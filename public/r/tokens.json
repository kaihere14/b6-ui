{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tokens",
  "title": "B6 Design Tokens",
  "description": "Colour, typography, radius, elevation and motion tokens every B6 UI component depends on.",
  "cssVars": {
    "theme": {
      "--ease-b6": "cubic-bezier(0.2, 0, 0, 1)",
      "--ease-b6-out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "--text-display": "3.25rem",
      "--text-h1": "2.25rem",
      "--text-h2": "1.5rem",
      "--text-h3": "1.125rem",
      "--text-body": "0.9375rem",
      "--text-small": "0.8125rem",
      "--text-caption": "0.6875rem",
      "--text-code": "0.8125rem",
      "--shadow-b6-xs": "0 1px 1px oklch(0 0 0 / 0.04)",
      "--shadow-b6-sm": "0 1px 2px oklch(0 0 0 / 0.06), 0 1px 6px oklch(0 0 0 / 0.04)",
      "--shadow-b6-md": "0 2px 4px oklch(0 0 0 / 0.06), 0 8px 20px oklch(0 0 0 / 0.07)",
      "--shadow-b6-lg": "0 4px 8px oklch(0 0 0 / 0.07), 0 18px 44px oklch(0 0 0 / 0.1)"
    },
    "light": {
      "background": "oklch(0.99 0.004 95)",
      "foreground": "oklch(0.18 0.012 75)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.18 0.012 75)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.18 0.012 75)",
      "primary": "oklch(0.68 0.165 58)",
      "primary-foreground": "oklch(0.16 0.03 60)",
      "secondary": "oklch(0.94 0.01 95)",
      "secondary-foreground": "oklch(0.24 0.014 75)",
      "muted": "oklch(0.96 0.008 95)",
      "muted-foreground": "oklch(0.5 0.014 80)",
      "accent": "oklch(0.93 0.03 90)",
      "accent-foreground": "oklch(0.24 0.02 70)",
      "destructive": "oklch(0.55 0.2 27)",
      "destructive-foreground": "oklch(0.99 0.005 95)",
      "border": "oklch(0.9 0.01 90)",
      "input": "oklch(0.93 0.008 90)",
      "ring": "oklch(0.68 0.165 58)",
      "radius": "0.5rem"
    },
    "dark": {
      "background": "oklch(0.16 0.008 75)",
      "foreground": "oklch(0.95 0.006 95)",
      "card": "oklch(0.19 0.009 75)",
      "card-foreground": "oklch(0.95 0.006 95)",
      "popover": "oklch(0.19 0.009 75)",
      "popover-foreground": "oklch(0.95 0.006 95)",
      "primary": "oklch(0.76 0.155 62)",
      "primary-foreground": "oklch(0.17 0.03 60)",
      "secondary": "oklch(0.24 0.012 75)",
      "secondary-foreground": "oklch(0.93 0.008 95)",
      "muted": "oklch(0.22 0.01 75)",
      "muted-foreground": "oklch(0.66 0.012 85)",
      "accent": "oklch(0.27 0.02 70)",
      "accent-foreground": "oklch(0.94 0.01 90)",
      "destructive": "oklch(0.62 0.19 27)",
      "destructive-foreground": "oklch(0.99 0.005 95)",
      "border": "oklch(0.28 0.012 78)",
      "input": "oklch(0.26 0.012 78)",
      "ring": "oklch(0.76 0.155 62)"
    }
  },
  "type": "registry:theme"
}