# The full gate. Push is rare enough to afford a few seconds, and catching a
# failure here is far cheaper than a red build on main.
#
# This runs the same steps as `bun run verify`, in the same order, so the
# hook and the release/CI gate never drift apart.

echo "Checking registry integrity..."
bun run registry:check || {
  echo ""
  echo "Registry is out of sync. See the error above, then re-run:"
  echo "  bun run registry:check"
  exit 1
}

echo "Typechecking..."
bun run typecheck || {
  echo ""
  echo "Typecheck failed. Fix the errors above, or push with --no-verify if"
  echo "you genuinely mean to push a broken build."
  exit 1
}

echo "Linting..."
bun run lint || exit 1

echo "Checking formatting..."
bun run format:check || {
  echo ""
  echo "Formatting is off. Run: bun run format"
  exit 1
}

echo "Running tests..."
bun run test || exit 1

echo "Building..."
bun run build || exit 1

echo "All checks passed."
